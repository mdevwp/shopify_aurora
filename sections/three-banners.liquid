<section class="three-banners">
  <div class="three-banners__grid collection-list__container container container--page-width section-spacing container--with-aside-paddings">
    {% for block in section.blocks %}
      <div class="three-banners__item">
        <div class="three-banners__image-wrapper">
          <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.alt_text }}">
        </div>
        {% if block.settings.caption != blank %}
          <div class="three-banners__caption">
            {{ block.settings.caption }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<style>
.three-banners__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.three-banners__item {
  overflow: hidden;
}
.three-banners__image-wrapper {
  overflow: hidden;
  margin-bottom: 0;
}
.three-banners__image-wrapper img {
  display: block;
  width: 100%;
  transition: transform 0.5s ease-in-out;
  transform-origin: center center;
}
.three-banners__image-wrapper:hover img {
  transform: scale(1.1);
}
.three-banners__caption {
  margin-top: 0;
  background-color: #f0f0f0;
  padding: 10px;
  text-align: center;
}

  /* Mobile swipe styles */
@media (max-width: 767px) {
  .three-banners__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .three-banners__item {
    flex: 0 0 80%;
    scroll-snap-align: start;
    margin-right: 16px;
  }
  /* Optional: hide scrollbar */
  .three-banners__grid::-webkit-scrollbar {
    display: none;
  }
  .three-banners__grid {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
}
  
</style>

{% schema %}
{
  "name": "Three banners",
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Your caption"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Banner image"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Three banners",
      "category": "Custom"
    }
  ]
}
{% endschema %}
