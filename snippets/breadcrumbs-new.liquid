<nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
  <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t | default: 'Home' }}</a>
  <span aria-hidden="true">&raquo;</span>
  <a href="{{ routes.all_products_collection_url }}">{{ 'general.breadcrumbs.shop' | t | default: 'Shop' }}</a>

  {% if product %}
    {% assign product_collection = collection %}

    {% if product_collection == blank and request.path contains '/collections/' and request.path contains '/products/' %}
      {% assign handle = request.path | split: '/collections/' | last | split: '/' | first %}
      {% assign product_collection = collections[handle] %}
    {% endif %}

    {% if product_collection == blank and product.collections.size > 0 %}
      {% assign product_collection = product.collections.first %}
    {% endif %}

    {% if product_collection %}
      <span aria-hidden="true">&raquo;</span>
      <a href="{{ product_collection.url }}">{{ product_collection.title }}</a>
    {% endif %}

    <span aria-hidden="true">&raquo;</span>
    <span aria-current="page">{{ product.title }}</span>

  {% elsif collection %}
    <span aria-hidden="true">&raquo;</span>
    <span aria-current="page">{{ collection.title }}</span>

  {% elsif article %}
    <span aria-hidden="true">&raquo;</span>
    <a href="{{ blog.url }}">{{ blog.title }}</a>
    <span aria-hidden="true">&raquo;</span>
    <span aria-current="page">{{ article.title }}</span>

  {% elsif page %}
    <span aria-hidden="true">&raquo;</span>
    <span aria-current="page">{{ page.title }}</span>
  {% endif %}
</nav>
