<nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
  <a href="{{ routes.root_url }}">Home</a>
  <span>»</span>
  <a href="{{ routes.all_products_collection_url }}">Shop</a>

  {% if product %}
    {% assign crumb_collection = collection %}

    {%- comment -%} Если URL содержит коллекцию, вытащим её handle {%- endcomment -%}
    {% if crumb_collection == blank and request.path contains '/collections/' and request.path contains '/products/' %}
      {% assign handle = request.path | split: '/collections/' | last | split: '/' | first %}
      {% assign crumb_collection = collections[handle] %}
    {% endif %}

    {%- comment -%} Fallback: первая коллекция товара {%- endcomment -%}
    {% if crumb_collection == blank and product.collections.size > 0 %}
      {% assign crumb_collection = product.collections.first %}
    {% endif %}

    {% if crumb_collection %}
      <span>»</span>
      <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a>
    {% endif %}

    <span>»</span>
    <span aria-current="page">{{ product.title }}</span>

  {% elsif article %}
    <span>»</span>
    <a href="{{ blog.url }}">{{ blog.title }}</a>
    <span>»</span>
    <span aria-current="page">{{ article.title }}</span>

  {% elsif page %}
    <span>»</span>
    <span aria-current="page">{{ page.title }}</span>
  {% endif %}
</nav>
